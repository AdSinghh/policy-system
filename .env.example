# Copy to .env and fill in. .env is gitignored and excluded from the Docker image;
# in deployment, inject these as real environment variables instead of shipping a file.

# ── Core ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/policydb
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ── Mongo connection pools (per process/thread) ─────────────────────────────
MONGO_POOL_SIZE=10
MONGO_WORKER_POOL_SIZE=5

# ── Cluster ─────────────────────────────────────────────────────────────────
# 1 makes the CPU-restart demo easy to observe. Use 2+ so a restart is not an outage.
CLUSTER_WORKERS=1

# ── CPU watchdog (Task 2.1) ─────────────────────────────────────────────────
CPU_THRESHOLD_PERCENT=70
CPU_SAMPLE_INTERVAL_MS=1000
CPU_SUSTAINED_SAMPLES=5
CPU_COOLDOWN_MS=30000
CPU_DRAIN_TIMEOUT_MS=15000
CPU_RESTART_DURING_IMPORT=false

# ── Import (Task 1.1) ───────────────────────────────────────────────────────
IMPORT_WORKERS=4
IMPORT_BATCH_SIZE=200
IMPORT_MAX_FILE_MB=25
IMPORT_CLEANUP_UPLOADS=true
UPLOAD_DIR=./uploads

# ── Scheduler (Task 2.2) ────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MS=15000
SCHEDULER_CLAIM_TIMEOUT_MS=120000
SCHEDULER_MAX_ATTEMPTS=3

# IANA zone used when a schedule request omits `timezone`.
DEFAULT_TIMEZONE=UTC

# ── Demo ────────────────────────────────────────────────────────────────────
# POST /api/system/load deliberately spikes CPU to trigger the watchdog.
ENABLE_LOAD_ENDPOINT=true
